{
  "name": "inkwell-novel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地小说创作工作台：多模型接入、大纲分卷、人物设定、去AI味写作工具",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "launch": "node scripts/launch.mjs",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "update-model-limits": "tsx scripts/update-model-limits.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "hono": "^4.13.13",
    "lucide-react": "^1.57.0",
    "lxgw-wenkai-screen-webfont": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
