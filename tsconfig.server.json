{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["server", "shared", "tests", "scripts", "vite.config.ts", "vitest.config.ts"]
}
